flowchart TD
    A[Inicio: App Web] --> B{¿Conexión BLE Activa?};

    B -- No --> C[Solicitar Conexión a ESP32];
    C --> D{Conexión Exitosa?};
    D -- No --> C;
    D -- Sí --> E[Habilitar Controles de Matriz];

    E --> F[Esperar Interacción de Usuario];
    F --> G[Usuario Modifica Estado de LED];

    G --> H[App: Empaquetar 22 Estados en 3 bytes];
    H --> I[App: Transmitir 3 bytes por Característica BLE];

    I --> J[ESP32: Recibir y Desempaquetar Datos];
    J --> K{¿Algún LED Encendido?};

    K -- Sí --> L[ESP32: Iniciar Ciclo de Multiplexación];
    K -- No --> M[ESP32: Apagar Pines de Control];

    L --> F;
    M --> F;