flowchart TD
    A[Inicio: App Web Cargada] --> B{¿Web Bluetooth Soportado?};

    B -- No --> C[Mostrar ERROR: Web Bluetooth NO SOPORTADO];
    B -- Sí --> D[Usuario inicia Conexión Bluetooth];

    D --> E[AppWeb: Solicita dispositivo BLE];
    E --> F{Dispositivo ESP32 Conectado?};

    F -- No/Cancelado --> D;
    F -- Sí --> G[AppWeb: Encuentra Servicio y Característica de LEDs];

    G --> H[Conexión Establecida: Controles Habilitados];

    H --> I[Usuario selecciona estado de LED];
    I --> J[AppWeb: Empaquetar estado de 22 LEDs en 3 bytes];
    J --> K[AppWeb: Transmitir 3 bytes a ESP32 vía BLE];

    K --> L{ESP32 recibe 3 bytes};
    L --> M[ESP32: Desempaquetar y Actualizar Matriz de Estado];
    M --> N{¿Al menos un LED Activo?};

    N -- Sí --> O[ESP32: Activar y Ejecutar Multiplexación];
    N -- No --> P[ESP32: Apagar LEDs y Desactivar Multiplexación];

    O --> H;
    P --> H;