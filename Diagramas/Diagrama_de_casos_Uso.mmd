%%{init: {'theme': 'default'}}%%
graph TD
    Usuario((Usuario))
    AppWeb((Aplicación Web BLE))
    ESP32((Controlador ESP32 - Firmware))

    %% Casos de uso de la App Web
    gestionarConexion[[1. Gestionar Conexión BLE (Conectar/Desconectar)]]
    cambiarEstadoLED[[2. Enviar Estado de LED Individual (r, c)]]
    controlMasivo[[3. Enviar Estado de Todos los LEDs (On/Off)]]
    monitorearBateria[[4. Mostrar Nivel de Batería]]
    visualizarRegistro[[5. Visualizar Registro de Eventos]]
    
    %% Flujos de datos/control
    Usuario --> AppWeb
    
    AppWeb --> gestionarConexion
    AppWeb --> cambiarEstadoLED
    AppWeb --> controlMasivo
    AppWeb --> visualizarRegistro
    
    cambiarEstadoLED --> ESP32 : <<write>> Nuevo Estado LED (3 bytes)
    controlMasivo --> ESP32 : <<write>> Nuevo Estado (3 bytes)
    
    ESP32 --> monitorearBateria : <<lee pin ADC>>
    
    ESP32 -.-> AppWeb : Lectura de Voltaje de Batería (Implícito/Por implementar)