@startuml
left to right direction
skinparam actorStyle awesome

actor Técnico as T
actor Profesor as P
actor Alumno as A

rectangle "Sistema" {
  (Utilizar canchas) as UC
  (Cambiar módulo) as CM
  (Actualizar software) as AS
  (Monitorear consumo de energía) as MCE
  (Solicitar mantenimiento) as SM
  (Reportar problemas) as RP
  (Ver módulos instalados) as VMI

  rectangle "Interfaz Gráfica" {
    (Seleccionar canchas predeterminadas) as SCP
    (Seleccionar dibujos libres) as DL
    (Seleccionar análisis de módulos) as AM
    (Apartado de fallas) as AF
    (Simulación visual) as SV
    (Notificaciones) as NO
    (Centro de ayuda) as CA

    (Sin batería) as SB
    (Leds quemados) as LQ
    (Batería quemada) as BQ
    (Mal clima) as MC
    (Módulo obstruido) as MO
    (Panel solar roto) as PSR
    (Humedad) as HU
    (Falla electrónica) as FE
  }
}

' Relaciones con actores
A --> UC

P --> SCP
P --> DL
P --> AM
P --> MCE
P --> SV
P --> NO
P --> CA
P --> RP
P --> SM
P --> VMI

T --> CM
T --> AS
T --> MCE
T --> NO
T --> CA
T <-- RP
T <-- SM
T --> VMI

AM --> AF
AF --> SB
AF --> LQ
SB --> BQ
SB --> MC
SB --> MO
SB --> PSR
SB --> HU
SB --> FE
@enduml
