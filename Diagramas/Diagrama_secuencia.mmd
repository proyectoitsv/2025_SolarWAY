sequenceDiagram
    actor Usuario
    participant AppWeb
    participant Caracteristica_BLE
    participant Firmware_ESP32
    
    Usuario->>AppWeb: Envío de Nuevo Estado de Matriz
    
    activate AppWeb
    AppWeb->>AppWeb: 1. Actualizar estado interno de las luces
    AppWeb->>AppWeb: 2. Codificar estado en un único paquete de datos
    
    AppWeb->>Caracteristica_BLE: Comando de Escritura
    deactivate AppWeb
    
    activate Caracteristica_BLE
    Caracteristica_BLE->>Firmware_ESP32: Notificación de Nuevo Dato
    deactivate Caracteristica_BLE
    
    activate Firmware_ESP32
    Firmware_ESP32->>Firmware_ESP32: 1. Decodificar el paquete de datos
    Firmware_ESP32->>Firmware_ESP32: 2. Actualizar Matriz de Control de Luces
    Firmware_ESP32->>Firmware_ESP32: 3. Comprobar si se requiere la activación de luces
    
    alt Luces Encendidas
        Firmware_ESP32->>Firmware_ESP32: Iniciar/Mantener Ciclo de Multiplexación
    else Luces Apagadas
        Firmware_ESP32->>Firmware_ESP32: Apagar todos los pines de control
    end
    deactivate Firmware_ESP32