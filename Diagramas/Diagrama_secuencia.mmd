sequenceDiagram
    actor Usuario
    participant AppWeb
    participant Caracteristica_BLE
    participant Firmware_ESP32
    
    Usuario->>AppWeb: Enviar comando de Matriz LED
    
    activate AppWeb
    AppWeb->>AppWeb: 1. Actualizar estado interno de 22 LEDs
    AppWeb->>AppWeb: 2. Codificar estado en un paquete de 3 bytes
    
    AppWeb->>Caracteristica_BLE: WRITE_CMD (3 bytes)
    deactivate AppWeb
    
    activate Caracteristica_BLE
    Caracteristica_BLE->>Firmware_ESP32: Notificación de Nuevo Dato
    deactivate Caracteristica_BLE
    
    activate Firmware_ESP32
    Firmware_ESP32->>Firmware_ESP32: 1. Decodificar el paquete de 3 bytes
    Firmware_ESP32->>Firmware_ESP32: 2. Actualizar Matriz de Control (ledMatrix)
    Firmware_ESP32->>Firmware_ESP32: 3. Comprobar si se requiere la Multiplexación
    
    alt LEDs Encendidos
        Firmware_ESP32->>Firmware_ESP32: Iniciar/Mantener Ciclo de Multiplexación
    else LEDs Apagados
        Firmware_ESP32->>Firmware_ESP32: Apagar todos los pines de control
    end
    deactivate Firmware_ESP32